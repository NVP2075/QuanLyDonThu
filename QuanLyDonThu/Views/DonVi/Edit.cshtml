@model DonViFormViewModel

@{
    ViewData["Title"] = "Sửa đơn vị";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="mb-4">
    <h1 class="h4 fw-bold text-dark mb-1">Sửa đơn vị</h1>
    <p class="text-muted mb-0">Cập nhật thông tin đơn vị #@Model.MaDonVi.</p>
</div>

<div class="admin-card form-card">
    <form asp-action="Edit" asp-route-id="@Model.MaDonVi" method="post" data-confirm-native="Xác nhận lưu thay đổi trạng thái và thông tin đơn vị?">
        <input asp-for="MaDonVi" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="TenDonVi" class="form-label"></label>
            <input asp-for="TenDonVi" class="form-control" maxlength="200" autocomplete="organization" />
            <span asp-validation-for="TenDonVi" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="DangHoatDong" class="form-check-input" />
            <label asp-for="DangHoatDong" class="form-check-label"></label>
            <span asp-validation-for="DangHoatDong" class="text-danger d-block"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-light">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
