@model DotTiepNhanFormViewModel
@{
    ViewData["Title"] = "Tạo đợt tiếp nhận";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="mb-4"><h1 class="h4 fw-bold text-dark mb-1">Tạo đợt tiếp nhận</h1><p class="text-muted mb-0">Chọn đơn vị và thiết lập khoảng thời gian nhận đơn.</p></div>
<div class="admin-card form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="TenSuKien" class="form-label"></label><input asp-for="TenSuKien" class="form-control" maxlength="250" /><span asp-validation-for="TenSuKien" class="text-danger"></span></div>
        @if (User.IsInRole("Admin"))
        {
            <div class="mb-3"><label asp-for="MaDonVi" class="form-label"></label><select asp-for="MaDonVi" asp-items="ViewBag.MaDonVi" class="form-select"><option value="">-- Chọn đơn vị --</option></select><span asp-validation-for="MaDonVi" class="text-danger"></span></div>
        }
        else
        {
            <input asp-for="MaDonVi" type="hidden" />
            <div class="mb-3"><label class="form-label">Đơn vị phụ trách</label><input value="@((ViewBag.MaDonVi as Microsoft.AspNetCore.Mvc.Rendering.SelectList)?.FirstOrDefault()?.Text)" class="form-control" disabled /></div>
        }
        <div class="mb-3"><label asp-for="NgaySuKien" class="form-label"></label><input asp-for="NgaySuKien" type="date" class="form-control" /><span asp-validation-for="NgaySuKien" class="text-danger"></span></div>
        <div class="row"><div class="col-md-6 mb-3"><label asp-for="ThoiGianMo" class="form-label"></label><input asp-for="ThoiGianMo" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><span asp-validation-for="ThoiGianMo" class="text-danger"></span></div><div class="col-md-6 mb-4"><label asp-for="ThoiGianDong" class="form-label"></label><input asp-for="ThoiGianDong" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><span asp-validation-for="ThoiGianDong" class="text-danger"></span></div></div>
        <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Tạo đợt</button><a asp-action="Index" class="btn btn-light">Hủy</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
