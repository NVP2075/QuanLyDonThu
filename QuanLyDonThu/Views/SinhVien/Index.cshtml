@model SinhVienDashboardViewModel
@{
    ViewData["Title"] = "Tổng quan sinh viên";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="h3 mb-1">Tổng quan sinh viên</h1><p class="text-muted mb-0">Theo dõi các đợt tiếp nhận và đơn thư gần đây.</p></div>
        <a asp-action="GuiDon" class="btn btn-primary"><i class="bi bi-send me-1"></i> Gửi đơn mới</a>
    </div>
    <section class="card shadow-sm mb-4">
        <div class="card-header bg-white"><h2 class="h5 mb-0">Đợt tiếp nhận đang mở</h2></div>
        <div class="card-body">
            @if (Model.DotTiepNhans.Count == 0)
            {
                <p class="text-muted mb-0">Hiện chưa có đợt tiếp nhận nào đang mở.</p>
            }
            else
            {
                <div class="table-responsive"><table class="table align-middle mb-0">
                    <thead><tr><th>Sự kiện</th><th>Mở từ</th><th>Đóng lúc</th><th></th></tr></thead>
                    <tbody>@foreach (var dot in Model.DotTiepNhans)
                    {
                        <tr><td>@dot.TenSuKien</td><td>@dot.ThoiGianMo.ToString("dd/MM/yyyy HH:mm")</td><td>@dot.ThoiGianDong.ToString("dd/MM/yyyy HH:mm")</td><td><a asp-action="GuiDon" asp-route-maDot="@dot.MaDot" class="btn btn-sm btn-outline-primary">Gửi đơn</a></td></tr>
                    }</tbody>
                </table></div>
            }
        </div>
    </section>
    <section class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center"><h2 class="h5 mb-0">5 đơn thư gần nhất</h2><a asp-action="LichSu">Xem lịch sử</a></div>
        <div class="card-body">
            @if (Model.DonThuGanDay.Count == 0)
            {
                <p class="text-muted mb-0">Bạn chưa gửi đơn thư nào.</p>
            }
            else
            {
                <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Mã đơn</th><th>Tiêu đề</th><th>Ngày gửi</th><th>Trạng thái</th><th></th></tr></thead><tbody>
                @foreach (var don in Model.DonThuGanDay)
                {
                    <tr><td>@don.MaCode</td><td>@don.TieuDe</td><td>@don.NgayTao?.ToString("dd/MM/yyyy HH:mm")</td><td>@don.TrangThai</td><td><a asp-action="ChiTiet" asp-route-id="@don.MaDon">Chi tiết</a></td></tr>
                }
                </tbody></table></div>
            }
        </div>
    </section>
</div>
