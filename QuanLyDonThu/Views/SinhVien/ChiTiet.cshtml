@model ChiTietDonThuViewModel
@{
    ViewData["Title"] = "Chi tiết đơn thư";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">@Model.TieuDe</h1><p class="text-muted mb-0">Mã đơn: @Model.MaCode</p></div><a asp-action="LichSu" class="btn btn-outline-secondary">Quay lại lịch sử</a></div>
    @if (TempData["Success"] is string message)
    {
        <div class="alert alert-success">@message</div>
    }
    <section class="card shadow-sm mb-4"><div class="card-header bg-white"><h2 class="h5 mb-0">Thông tin đơn</h2></div><div class="card-body">
        <dl class="row mb-0"><dt class="col-sm-3">Lĩnh vực</dt><dd class="col-sm-9">@Model.TenLinhVuc</dd><dt class="col-sm-3">Đơn vị tiếp nhận</dt><dd class="col-sm-9">@Model.TenDonVi</dd><dt class="col-sm-3">Đợt tiếp nhận</dt><dd class="col-sm-9">@(Model.TenDot ?? "Gửi tự do")</dd><dt class="col-sm-3">Ngày gửi</dt><dd class="col-sm-9">@Model.NgayTao?.ToString("dd/MM/yyyy HH:mm")</dd><dt class="col-sm-3">Hạn xử lý</dt><dd class="col-sm-9">@Model.NgayHenXuLy.ToString("dd/MM/yyyy")</dd><dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9">@Model.TrangThai</dd><dt class="col-sm-3">Nội dung</dt><dd class="col-sm-9">@Model.NoiDung</dd></dl>
    </div></section>
    <section class="card shadow-sm mb-4"><div class="card-header bg-white"><h2 class="h5 mb-0">Tệp minh chứng</h2></div><div class="card-body">
        @if (Model.TepMinhChungs.Count == 0)
        {
            <p class="text-muted mb-0">Không có tệp đính kèm.</p>
        }
        else
        {
            <ul class="mb-0">@foreach (var tep in Model.TepMinhChungs) { <li><a href="@tep.DuongDan">@tep.TenTepGoc</a></li> }</ul>
        }
    </div></section>
    <section class="card shadow-sm"><div class="card-header bg-white"><h2 class="h5 mb-0">Phản hồi</h2></div><div class="card-body">
        @if (Model.PhanHois.Count == 0)
        {
            <p class="text-muted mb-0">Chưa có phản hồi.</p>
        }
        else
        {
            @foreach (var phanHoi in Model.PhanHois)
            {
                <article class="border-bottom pb-3 mb-3"><div class="d-flex justify-content-between"><strong>@phanHoi.NguoiGui</strong><small class="text-muted">@phanHoi.NgayGui?.ToString("dd/MM/yyyy HH:mm")</small></div><p class="mb-0 mt-2">@phanHoi.NoiDung</p></article>
            }
        }
    </div></section>
</div>
