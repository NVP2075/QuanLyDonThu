@model GuiDonViewModel
@{
    ViewData["Title"] = "Gửi đơn thư";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid py-4">
    <h1 class="h3 mb-4">Gửi đơn thư</h1>
    <form asp-action="GuiDon" method="post" enctype="multipart/form-data" class="card shadow-sm">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @if (Model.MaDot.HasValue)
            {
                <input asp-for="MaDot" type="hidden" />
                <div class="alert alert-info">Đơn được gửi trong đợt tiếp nhận đã chọn.</div>
            }
            <div class="mb-3"><label asp-for="MaLinhVuc" class="form-label"></label><select asp-for="MaLinhVuc" asp-items="ViewBag.MaLinhVuc" class="form-select"><option value="">-- Chọn lĩnh vực --</option></select><span asp-validation-for="MaLinhVuc" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="TieuDe" class="form-label"></label><input asp-for="TieuDe" class="form-control" maxlength="300" /><span asp-validation-for="TieuDe" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="NoiDung" class="form-label"></label><textarea asp-for="NoiDung" class="form-control" rows="8"></textarea><span asp-validation-for="NoiDung" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="FileMinhChung" class="form-label"></label><input asp-for="FileMinhChung" type="file" accept=".jpg,.jpeg,.png,.pdf" class="form-control" /><div class="form-text">Chấp nhận JPG, PNG hoặc PDF; tối đa 5 MB.</div><span asp-validation-for="FileMinhChung" class="text-danger"></span></div>
        </div>
        <div class="card-footer bg-white d-flex gap-2"><button type="submit" class="btn btn-primary">Gửi đơn</button><a asp-action="Index" class="btn btn-outline-secondary">Hủy</a></div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
