@model UserManagementFormViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="mb-4"><h1 class="h4 fw-bold text-dark mb-1">Tạo tài khoản</h1><p class="text-muted mb-0">Tên đăng nhập là MSSV đối với sinh viên hoặc mã cán bộ đối với các vai trò khác.</p></div>
<div class="admin-card form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="UserName" class="form-label"></label><input asp-for="UserName" class="form-control" autocomplete="username" /><span asp-validation-for="UserName" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" asp-items="ViewBag.Roles" class="form-select" id="roleSelect"></select><span asp-validation-for="Role" class="text-danger"></span></div>
        <div id="studentFields" class="@(Model.Role == "SinhVien" ? "" : "d-none")">
            <div class="mb-3"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control" autocomplete="name" /><span asp-validation-for="HoTen" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="Lop" class="form-label"></label><input asp-for="Lop" class="form-control" /><span asp-validation-for="Lop" class="text-danger"></span></div>
        </div>
        <div id="staffFields" class="@(Model.Role == "CanBo" ? "" : "d-none")">
            <div class="mb-3"><label asp-for="MaDonVi" class="form-label"></label><select asp-for="MaDonVi" asp-items="ViewBag.MaDonVi" class="form-select"><option value="">-- Chọn đơn vị công tác --</option></select><span asp-validation-for="MaDonVi" class="text-danger"></span></div>
        </div>
        <div class="mb-4"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
        <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Tạo tài khoản</button><a asp-action="Index" class="btn btn-light">Hủy</a></div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('roleSelect').addEventListener('change', event => {
            document.getElementById('studentFields').classList.toggle('d-none', event.target.value !== 'SinhVien');
            document.getElementById('staffFields').classList.toggle('d-none', event.target.value !== 'CanBo');
        });
    </script>
}
