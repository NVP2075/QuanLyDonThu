@model CanBoIndexViewModel
@{
    ViewData["Title"] = "Tổng quan đơn vị";
    Layout = "_LayoutAdmin";
    string StatusLabel(int status) => status switch { 0 => "Mới", 1 => "Đang xử lý", 2 => "Đã đóng", _ => "Không xác định" };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="h3 mb-1">Tổng quan @Model.TenDonVi</h1><p class="text-muted mb-0">Tình hình xử lý đơn thư của đơn vị bạn.</p></div>
        <a asp-controller="DotTiepNhan" asp-action="Index" class="btn btn-outline-primary">Quản lý đợt tiếp nhận</a>
    </div>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" data-auto-dismiss>@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" data-auto-dismiss>@error</div> }
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="admin-card p-4"><div class="text-muted">Đơn mới</div><div class="h2 mb-0">@Model.SoDonMoi</div></div></div>
        <div class="col-md-3"><div class="admin-card p-4"><div class="text-muted">Đang xử lý</div><div class="h2 mb-0">@Model.SoDonDangXuLy</div></div></div>
        <div class="col-md-3"><div class="admin-card p-4"><div class="text-muted">Đã đóng</div><div class="h2 mb-0">@Model.SoDonDaDong</div></div></div>
        <div class="col-md-3"><div class="admin-card p-4"><div class="text-danger">Đơn quá hạn</div><div class="h2 mb-0 text-danger">@Model.SoDonQuaHan</div></div></div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h5 mb-1">Hàng đợi đơn thư</h2><p class="text-muted mb-0">Chỉ hiển thị đơn thuộc lĩnh vực phụ trách của đơn vị bạn.</p></div></div>
    <div class="admin-card p-3 mb-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-5"><label for="search" class="form-label">Tìm mã đơn, tiêu đề hoặc MSSV</label><input id="search" name="search" value="@Model.Search" class="form-control" /></div>
            <div class="col-md-3"><label for="trangThai" class="form-label">Trạng thái</label><select id="trangThai" name="trangThai" class="form-select"><option value="">Tất cả trạng thái</option><option value="0" selected="@(Model.TrangThai == 0)">Mới</option><option value="1" selected="@(Model.TrangThai == 1)">Đang xử lý</option><option value="2" selected="@(Model.TrangThai == 2)">Đã đóng</option></select></div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Lọc</button> <a asp-action="Index" class="btn btn-light">Xóa lọc</a></div>
        </form>
    </div>
    <div class="admin-card table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Mã đơn / Tiêu đề</th><th>Sinh viên</th><th>Ngày gửi</th><th>Hạn xử lý</th><th>Trạng thái</th><th>Cán bộ</th><th></th></tr></thead>
            <tbody>
                @if (Model.DonThus.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Không có đơn thư phù hợp.</td></tr> }
                @foreach (var item in Model.DonThus)
                {
                    <tr class="@(item.QuaHan ? "table-danger" : "")">
                        <td><div class="fw-semibold">@(item.MaCode ?? $"#{item.MaDon}")</div><div>@item.TieuDe</div></td>
                        <td>@item.HoTenSinhVien<br /><small class="text-muted">@item.MaSinhVien</small></td>
                        <td>@item.NgayTao?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@if (item.QuaHan) { <span class="text-danger fw-bold"><i class="bi bi-clock-history"></i> Quá hạn @Math.Abs(item.SoNgayConLai) ngày</span> } else if (item.TrangThai != 2) { <span class="text-success">Còn @item.SoNgayConLai ngày</span> } else { <span>@item.NgayHenXuLy.ToString("dd/MM/yyyy")</span> }</td>
                        <td><span class="badge @(item.TrangThai == 0 ? "text-bg-primary" : item.TrangThai == 1 ? "text-bg-warning" : "text-bg-success")">@StatusLabel(item.TrangThai)</span></td>
                        <td>@(item.MaCanBoXuLy ?? "Chưa nhận")</td>
                        <td><a asp-action="ChiTiet" asp-route-id="@item.MaDon" class="btn btn-sm btn-outline-primary">Xem & xử lý</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
