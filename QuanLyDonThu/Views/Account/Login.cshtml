@model QuanLyDonThu.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - STU Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
</head>
<body>
    <div class="bg-shape bg-shape-1"></div>
    <div class="bg-shape bg-shape-2"></div>

    <main class="login-card">
        <div class="text-center mb-4">
            <div class="login-logo" aria-hidden="true">
                <i class="bi bi-envelope-paper-fill"></i>
            </div>
            <h1 class="login-title h4 fw-bold">Chào mừng trở lại</h1>
            <p class="text-muted mb-0 login-subtitle">Vui lòng đăng nhập vào STU Portal</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Mã Sinh viên / Mã Cán bộ</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="Username" class="form-control" autocomplete="username" placeholder="Nhập MSSV hoặc mã cán bộ" autofocus />
                </div>
                <span asp-validation-for="Username" class="text-danger login-field-validation"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                    <button class="btn btn-outline-secondary border-0 bg-transparent text-muted" type="button" id="togglePassword" aria-label="Hiện mật khẩu">
                        <i class="bi bi-eye-slash" id="eyeIcon" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger login-field-validation"></span>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3 login-validation"></div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-muted remember-label">Ghi nhớ đăng nhập</label>
            </div>

            <button type="submit" class="btn btn-primary btn-login w-100 text-white">
                Đăng nhập <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top">
            <p class="text-muted mb-0 login-note">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                Tài khoản do Nhà trường cấp. Vui lòng liên hệ Phòng CTSV nếu cần hỗ trợ.
            </p>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>
