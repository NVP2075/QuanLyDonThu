@model IReadOnlyList<LinhVucListItemViewModel>

@{
    ViewData["Title"] = "Quản lý Lĩnh vực";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">Quản lý Lĩnh vực</h1>
        <p class="text-muted mb-0">Danh mục các loại đơn thư và đơn vị phụ trách.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold px-3">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Thêm lĩnh vực
    </a>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="admin-card h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width:48px;height:48px"><i class="bi bi-tags fs-5" aria-hidden="true"></i></div>
                <div><div class="small text-muted fw-semibold">Tổng số lĩnh vực</div><div class="h3 fw-bold mb-0">@Model.Count</div></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="admin-card h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info-subtle text-info d-flex align-items-center justify-content-center" style="width:48px;height:48px"><i class="bi bi-clock-history fs-5" aria-hidden="true"></i></div>
                <div><div class="small text-muted fw-semibold">Hạn xử lý trung bình</div><div class="h3 fw-bold mb-0">@(Model.Count == 0 ? 0 : Math.Round(Model.Average(x => x.SoNgayXuLyMacDinh), 1)) <span class="fs-6 fw-normal text-muted">ngày</span></div></div>
            </div>
        </div>
    </div>
</div>

<div class="admin-card">
    <div class="p-3 p-md-4">
        <div class="d-flex flex-wrap gap-2 justify-content-between mb-3">
            <div class="input-group" style="max-width:360px">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted" aria-hidden="true"></i></span>
                <input id="linhVucSearch" type="search" class="form-control bg-light border-start-0" placeholder="Tìm lĩnh vực hoặc đơn vị..." aria-label="Tìm lĩnh vực" />
            </div>
            <select id="linhVucStatus" class="form-select" style="max-width:210px" aria-label="Lọc trạng thái">
                <option value="all">Tất cả trạng thái</option>
                <option value="active">Đang hoạt động</option>
                <option value="inactive">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Mã lĩnh vực</th><th>Tên lĩnh vực</th><th>Đơn vị phụ trách</th><th>Hạn xử lý</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody id="linhVucRows">
                    @foreach (var item in Model)
                    {
                        <tr data-search="@($"{item.MaLinhVuc} {item.TenLinhVuc} {item.TenDonVi}".ToLowerInvariant())" data-status="@(item.DangHoatDong ? "active" : "inactive")">
                            <td class="fw-bold text-primary">#@item.MaLinhVuc</td>
                            <td class="fw-semibold">@item.TenLinhVuc</td>
                            <td><span class="badge bg-secondary-subtle text-dark px-3 py-2 border"><i class="bi bi-building me-1" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(item.TenDonVi) ? "Chưa gán" : item.TenDonVi)</span></td>
                            <td><i class="bi bi-clock text-warning me-1" aria-hidden="true"></i>@item.SoNgayXuLyMacDinh ngày</td>
                            <td>
                                @if (item.DangHoatDong)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger-subtle text-danger">Ngừng hoạt động</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.MaLinhVuc" class="btn btn-sm btn-light text-primary" title="Sửa" aria-label="Sửa lĩnh vực"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                                <form asp-action="ToggleStatus" asp-route-id="@item.MaLinhVuc" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái lĩnh vực này?');">
                                    <button type="submit" class="btn btn-sm btn-light @(item.DangHoatDong ? "text-danger" : "text-success")" title="Đổi trạng thái" aria-label="Đổi trạng thái"><i class="bi @(item.DangHoatDong ? "bi-lock" : "bi-unlock")" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><p>Chưa có lĩnh vực nào trong hệ thống.</p></div>
            }
            <div id="linhVucNoResults" class="empty-state d-none"><i class="bi bi-search" aria-hidden="true"></i><p>Không tìm thấy lĩnh vực phù hợp.</p></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById('linhVucSearch');
            const status = document.getElementById('linhVucStatus');
            const rows = [...document.querySelectorAll('#linhVucRows tr')];
            const noResults = document.getElementById('linhVucNoResults');
            const filterRows = () => {
                const query = search.value.trim().toLocaleLowerCase();
                let visible = 0;
                rows.forEach(row => {
                    const matches = row.dataset.search.includes(query) && (status.value === 'all' || row.dataset.status === status.value);
                    row.classList.toggle('d-none', !matches);
                    if (matches) visible++;
                });
                noResults.classList.toggle('d-none', visible !== 0 || rows.length === 0);
            };
            search.addEventListener('input', filterRows);
            status.addEventListener('change', filterRows);
        })();
    </script>
}
