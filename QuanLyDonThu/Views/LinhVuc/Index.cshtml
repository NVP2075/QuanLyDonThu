@model LinhVucIndexViewModel

@{
    ViewData["Title"] = "Quản lý Lĩnh vực";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" data-auto-dismiss>
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">Quản lý Lĩnh vực</h1>
        <p class="text-muted mb-0">Danh mục các loại đơn thư và đơn vị phụ trách.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary fw-semibold px-3">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Thêm lĩnh vực
    </a>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" data-auto-dismiss>
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width:48px;height:48px"><i class="bi bi-tags fs-5" aria-hidden="true"></i></div>
                <div><div class="small text-muted fw-semibold">Tổng số lĩnh vực</div><div class="h3 fw-bold mb-0">@Model.TotalCount</div></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-card h-100 p-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width:48px;height:48px"><i class="bi bi-check-circle fs-5" aria-hidden="true"></i></div>
                <div><div class="small text-muted fw-semibold">Đang hoạt động</div><div class="h3 fw-bold mb-0">@Model.ActiveCount</div></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3"><div class="admin-card h-100 p-3"><div class="d-flex align-items-center gap-3"><div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width:48px;height:48px"><i class="bi bi-pause-circle fs-5" aria-hidden="true"></i></div><div><div class="small text-muted fw-semibold">Ngừng hoạt động</div><div class="h3 fw-bold mb-0">@Model.InactiveCount</div></div></div></div></div>
    <div class="col-sm-6 col-xl-3"><div class="admin-card h-100 p-3"><div class="d-flex align-items-center gap-3"><div class="rounded-circle bg-info-subtle text-info d-flex align-items-center justify-content-center" style="width:48px;height:48px"><i class="bi bi-clock-history fs-5" aria-hidden="true"></i></div><div><div class="small text-muted fw-semibold">Hạn xử lý trung bình</div><div class="h3 fw-bold mb-0">@Math.Round(Model.AverageDays, 1) <span class="fs-6 fw-normal text-muted">ngày</span></div></div></div></div></div>
</div>

<div class="admin-card" data-bulk-list>
    <div class="p-3 p-md-4">
        <div class="d-flex flex-wrap gap-2 justify-content-between mb-3">
            <form method="get" asp-action="Index" class="d-flex flex-wrap gap-2">
            <div class="input-group" style="max-width:360px">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted" aria-hidden="true"></i></span>
                <input name="search" type="search" value="@Model.Search" class="form-control bg-light border-start-0" placeholder="Tìm lĩnh vực hoặc đơn vị..." aria-label="Tìm lĩnh vực" />
            </div>
            <select name="status" class="form-select" style="max-width:210px" aria-label="Lọc trạng thái">
                <option value="all" selected="@(Model.Status == "all")">Tất cả trạng thái</option>
                <option value="active" selected="@(Model.Status == "active")">Đang hoạt động</option>
                <option value="inactive" selected="@(Model.Status == "inactive")">Ngừng hoạt động</option>
            </select>
            <button type="submit" class="btn btn-primary">Lọc</button><a asp-action="Index" class="btn btn-light">Xóa lọc</a>
            </form>
        </div>
        <div class="table-responsive">
            <form asp-action="BulkToggleStatus" method="post" id="linhVucBulkForm" data-confirm="Bạn có chắc muốn bật/tắt trạng thái các lĩnh vực đã chọn?">
                @Html.AntiForgeryToken()
                <div class="d-none d-flex align-items-center gap-2 flex-wrap mb-3" data-bulk-toolbar>
                    <span class="text-muted small me-2"><span data-selected-count>0</span> đã chọn</span>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Bật/tắt trạng thái</button>
                </div>
            </form>
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th><input type="checkbox" class="form-check-input" aria-label="Chọn tất cả lĩnh vực" data-select-all /></th><th>Mã lĩnh vực</th><th>Tên lĩnh vực</th><th>Đơn vị phụ trách</th><th>Hạn xử lý</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody id="linhVucRows">
                    @foreach (var item in Model.Page)
                    {
                        <tr>
                            <td><input type="checkbox" class="form-check-input" name="ids" value="@item.MaLinhVuc" form="linhVucBulkForm" aria-label="Chọn lĩnh vực @item.TenLinhVuc" data-row-select /></td>
                            <td class="fw-bold text-primary">#@item.MaLinhVuc</td>
                            <td class="fw-semibold">@item.TenLinhVuc</td>
                            <td><span class="badge bg-secondary-subtle text-dark px-3 py-2 border"><i class="bi bi-building me-1" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(item.TenDonVi) ? "Chưa gán" : item.TenDonVi)</span></td>
                            <td><i class="bi bi-clock text-warning me-1" aria-hidden="true"></i>@item.SoNgayXuLyMacDinh ngày</td>
                            <td>
                                @if (item.DangHoatDong)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger-subtle text-danger">Ngừng hoạt động</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.MaLinhVuc" class="btn btn-sm btn-light text-primary" title="Sửa lĩnh vực" data-bs-toggle="tooltip" aria-label="Sửa lĩnh vực"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                                <form asp-action="ToggleStatus" asp-route-id="@item.MaLinhVuc" method="post" class="d-inline" data-confirm="Bạn có chắc muốn đổi trạng thái lĩnh vực này?">
                                    <button type="submit" class="btn btn-sm btn-light @(item.DangHoatDong ? "text-danger" : "text-success")" title="@(item.DangHoatDong ? "Ngừng hoạt động lĩnh vực" : "Mở hoạt động lĩnh vực")" data-bs-toggle="tooltip" aria-label="Đổi trạng thái"><i class="bi @(item.DangHoatDong ? "bi-lock" : "bi-unlock")" aria-hidden="true"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.Page.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><p>Chưa có lĩnh vực nào trong hệ thống.</p></div>
            }
            else { <partial name="_Pagination" model="@(new PaginationViewModel { PageNumber = Model.Page.PageNumber, TotalPages = Model.Page.TotalPages, Search = Model.Search, Status = Model.Status, StatusParameter = "status" })" /> }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const modalElement = document.getElementById('actionConfirmModal');
            const modal = new bootstrap.Modal(modalElement);
            const message = document.getElementById('actionConfirmMessage');
            let pendingForm = null;
            document.querySelectorAll('form[data-confirm]').forEach(form => form.addEventListener('submit', event => {
                event.preventDefault();
                pendingForm = form;
                message.textContent = form.dataset.confirm;
                modal.show();
            }));
            document.getElementById('actionConfirmSubmit').addEventListener('click', () => {
                if (!pendingForm) return;
                pendingForm.submit();
            });
            modalElement.addEventListener('hidden.bs.modal', () => { pendingForm = null; });
        })();
    </script>
}

<div class="modal fade" id="actionConfirmModal" tabindex="-1" aria-labelledby="actionConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow">
        <div class="modal-header"><h2 class="modal-title fs-5" id="actionConfirmTitle">Xác nhận thao tác</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body" id="actionConfirmMessage"></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button type="button" class="btn btn-primary" id="actionConfirmSubmit">Xác nhận</button></div>
    </div></div>
</div>
